# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/odonto_flow?schema=public"

# Auth.js / Google OAuth
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_TRUST_HOST="true"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/integrations/google-calendar/callback"
CALENDAR_TOKEN_ENCRYPTION_KEY=""

# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mercado Pago subscriptions (monthly, with one free month)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
# Monthly price in cents. Example: 9900 = R$ 99,00.
MERCADO_PAGO_SUBSCRIPTION_AMOUNT_CENTS=""
MERCADO_PAGO_CURRENCY="BRL"
# Optional. If empty, the application creates and stores the plan on the first checkout.
MERCADO_PAGO_PLAN_ID=""

# Private S3-compatible object storage (AWS S3, Cloudflare R2, Moto, etc.)
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="odonto-flow-private"
STORAGE_ACCESS_KEY_ID="test"
STORAGE_SECRET_ACCESS_KEY="test"
# Moto endpoint. Leave empty for AWS S3.
STORAGE_ENDPOINT="http://localhost:5000"
STORAGE_FORCE_PATH_STYLE="true"
STORAGE_MAX_FILE_SIZE_MB="10"

# Backend jobs and optional messaging webhook
CRON_SECRET=""
MESSAGING_WEBHOOK_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_CONFIRMATION_TEMPLATE="appointment_confirmation"
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_GRAPH_API_VERSION="v23.0"
WHATSAPP_DEFAULT_COUNTRY_CODE="55"

# Optional: use an existing Google-authenticated user when running the dev seed.
SEED_USER_EMAIL=""
